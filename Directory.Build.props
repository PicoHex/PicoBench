<Project>
  <!-- ═══════════════════════════════════════════════════════
       PicoBench repo-wide build properties
       (src/ has its own Directory.Build.props, which imports this one)
       ═══════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!--
      Lock files. A restore records what it actually resolved in a
      packages.lock.json next to each project, and the main CI restore steps run
      with RestoreLockedMode=true (.github/workflows/ci.yml), so a dependency can
      only move when a lock file moves. A lock file that nobody refreshes would
      freeze the graph instead, which is why .github/workflows/deps-refresh.yml
      re-evaluates it weekly and turns any delta into a PR.

      Not every project commits a lock file, and that is deliberate:

        * tests/compat/ConsumerSdk8 and tests/compat/ConsumerNetStandard20
          install a freshly packed PicoBench at a per-run CI version
          (0.0.0-ci.<run_number>) from a local feed, so their graph is a
          property of the run, not of the repository;
        * the harness fixtures (tests/aot-negative,
          tests/compat/PicoBench.Net4xSmoke) are restored by CI steps that
          publish for a specific RID and deliberately do NOT run in locked mode,
          so their lock would be rewritten on every run.

      Both are restored without RestoreLockedMode, so a missing lock file there
      is created freely and can never fail a build.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Never infer a RuntimeIdentifier. A RID that is picked for us is a RID that
      ends up in a lock file that is shared by every machine.

      PublishAot needs a runtime, so publish defaults this switch to true and
      fills in the *host* RID when the command line does not name one. The lock
      file then records a runtime section that is only true on the machine that
      produced it (win-x64 on a developer box, linux-x64 on a runner), and the
      next locked restore anywhere else fails with NU1004: the lock file is not
      up to date with the project's dependencies. That is a red build which says
      nothing about the code.

      The RID belongs on the command line, where a workflow that genuinely
      publishes for a specific platform names it (ci.yml and the AOT probe both
      pass the runtime explicitly). Nothing is inferred, so nothing leaks into
      the locks.
    -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>
</Project>

