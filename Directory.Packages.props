<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roslyn: follow the latest stable, like every other package here. There
         is no version ceiling any more - the repository builds on the .NET 10
         SDK, so the generator targets the compiler that ships with it. If a
         future bump breaks the generator, the fix is in our code, not a pin. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="System.IO.Abstractions" Version="23.0.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="TUnit" Version="1.83.8" />
  </ItemGroup>
</Project>
