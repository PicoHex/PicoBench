<Project>
  <PropertyGroup>
    <!-- Default: do not produce NuGet packages from every project in the repo -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <!-- Default version for local development; CI overrides via -p:Version=<tag> -->
    <Version>0.0.0-dev</Version>

    <!--
      PicoHex baseline: true keeps inner-loop builds on project references,
      false switches release validation to package references. PicoBench ships a
      single package (the generator is embedded, never packed standalone), so no
      project currently has a PackageReference mode; the property is kept for
      org-wide pipeline consistency and future consumer packages.
    -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>

    <!-- Repository information for SourceLink -->
    <RepositoryUrl>https://github.com/PicoHex/PicoBench</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Common package metadata (applies to packed projects; harmless for others) -->
    <Authors>PicoHex</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PicoHex/PicoBench</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    
    <!-- Deterministic build & SourceLink -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Common build properties -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Symbol packages (snupkg) -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- SourceLink for source-level debugging -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
