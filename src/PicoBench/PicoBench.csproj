<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- netstandard2.0 assemblies cannot be AOT-published. Kept local (with
       TreatAsLocalProperty) so a consuming app's -p:PublishAot=true global
       property does not propagate into this project reference. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>PicoBench</PackageId>
    <Authors>PicoHex</Authors>
    <Description>A lightweight, zero-dependency, cross-platform benchmarking library for .NET with imperative and attribute-based APIs. Includes an AOT-compatible source generator. Supports Console, CSV, Markdown and HTML output formats.</Description>
    <PackageTags>benchmark;performance;testing;cross-platform;aot;source-generator</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PicoBench.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the source generator so consumers get it automatically -->
    <ProjectReference
      Include="..\PicoBench.Generators\PicoBench.Generators.csproj"
      PrivateAssets="all"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- ValueTask<T> support for netstandard2.0 -->
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include the source generator DLL in the buildTransitive folder to avoid file lock contention -->
    <None
      Include="..\PicoBench.Generators\$(OutputPath)PicoBench.Generators.dll"
      Pack="true"
      PackagePath="buildTransitive/PicoBench.Generators/analyzers/dotnet/cs"
      Visible="false"
    />

    <!-- Include main package props file to satisfy NuGet warning -->
    <None
      Include="..\buildTransitive\PicoBench.props"
      Pack="true"
      PackagePath="buildTransitive/PicoBench.props"
      Visible="false"
    />

    <!-- Include the root README in the NuGet package -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
