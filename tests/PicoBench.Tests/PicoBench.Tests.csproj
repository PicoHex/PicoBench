<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableCodeCoverage>true</EnableCodeCoverage>
    <IncludeSource>true</IncludeSource>
  </PropertyGroup>

  <ItemGroup>
    <!-- Main project reference -->
    <ProjectReference Include="..\..\src\PicoBench\PicoBench.csproj" />
    
    <!-- Source generator project (as regular library) for testing internals -->
    <ProjectReference Include="..\..\src\PicoBench.Generators\PicoBench.Generators.csproj" />

    <!-- Source generator project (as analyzer) so [BenchmarkClass] test classes
         get their IBenchmarkClass implementation generated -->
    <ProjectReference
      Include="..\..\src\PicoBench.Generators\PicoBench.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    
    <!-- TUnit testing framework -->
    <PackageReference Include="TUnit" />

    <!-- Roslyn APIs for generator integration tests -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="All" />
    
    <!-- File system helpers for test cleanup -->
    <PackageReference Include="System.IO.Abstractions" PrivateAssets="All" />
  </ItemGroup>
</Project>
