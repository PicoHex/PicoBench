<Project Sdk="Microsoft.NET.Sdk">

  <!--
    "netstandard2.0 consumer" leg of the compatibility matrix (review items
    B3-C5 / 0.7). The library itself targets netstandard2.0; this project proves
    another netstandard2.0 library can consume the package and compile the
    generated code - the case where `ValueTask.FromResult` (net5+) used to leak
    into the emitted source and break the build with CS0117.

    G20: this project sets `<Nullable>enable</Nullable>` on purpose (it stands in
    for a nullable-aware consumer) and netstandard2.0 derives C# 7.3 - a
    combination the compiler itself rejects with `CS8630: Invalid 'nullable' value:
    'Enable' for C# 7.3`. The 8.0 pin below is therefore required by THIS project's
    own nullable setting, not by the generated code: the generator now emits
    7.3-compatible code, and `PicoBench.Net4xSmoke` (nullable disabled, no
    LangVersion) proves that. Do not read this pin as a floor the library needs.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>8.0</LangVersion>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoBench" Version="$(PicoBenchVersion)" />
  </ItemGroup>

</Project>
