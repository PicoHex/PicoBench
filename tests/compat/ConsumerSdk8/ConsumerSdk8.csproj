<Project Sdk="Microsoft.NET.Sdk">

  <!--
    "SDK 8 consumer" leg of the compatibility matrix (review items B3-C1 / 0.6).

    The generator is compiled against Roslyn 4.8 (Directory.Packages.props) so
    that it can run inside the SDK 8 compiler; a generator built against a newer
    Roslyn is silently skipped there (CS9057 only), and the consumer then fails
    with CS1061 on a type the generator never produced. Only an actual SDK 8
    build proves that, so this project pins SDK 8 through its own global.json.

    It consumes the *package* (local feed), not a ProjectReference: the analyzer
    reaches consumers through buildTransitive props, which is the path a real
    consumer takes.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The repository uses central package management; this project lives
         outside that policy on purpose (it stands in for an external consumer). -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Neither of these resolve from the repository: the consumer is standalone. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoBench" Version="$(PicoBenchVersion)" />
  </ItemGroup>

</Project>
